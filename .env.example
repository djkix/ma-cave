# Copier vers .env et remplir. Ne jamais commiter .env.
# TLS et sous-domaine public sont gérés par Nginx Proxy Manager en amont.

TZ=Europe/Paris
IMAGE_TAG=latest
# Seul port publié sur l'hôte ; NPM pointe dessus (proxy host -> <ip-docker>:${WEB_PORT}).
WEB_PORT=3100
# Adresse de l'hôte sur laquelle ce port est publié. NPM doit pouvoir la joindre :
# - NPM sur cette même machine, hors Docker : 127.0.0.1 (défaut) ;
# - NPM dans un conteneur de cette machine : l'adresse de la passerelle Docker
#   vue par NPM (souvent 172.17.0.1) ;
# - NPM sur une autre machine : l'adresse de CETTE machine sur le réseau local,
#   et un pare-feu qui n'ouvre le port qu'à l'hôte de NPM (le conteneur web fait
#   confiance aux en-têtes X-Forwarded-* qu'il reçoit).
# Ne jamais mettre 0.0.0.0 sur une machine exposée.
WEB_BIND=127.0.0.1

# ---- Postgres ----
POSTGRES_USER=cave
POSTGRES_PASSWORD=__REMPLACER__   # openssl rand -hex 24
POSTGRES_DB=cave

# ---- Sessions ----
SESSION_SECRET=__REMPLACER__      # openssl rand -hex 32, 32 caractères minimum
# Nombre de proxys devant l'api : Nginx Proxy Manager puis le nginx du conteneur
# web (2 par défaut). Sert à retrouver l'adresse réelle du client (limiteur de
# débit, journaux). À ajuster seulement si la chaîne de proxys change.
TRUST_PROXY_HOPS=2
# Origine publique de l'application (redirections OAuth et cookies)
WEB_ORIGIN=https://cave.example.org

# ---- Google OAuth (OpenID Connect, scopes openid/email/profile uniquement) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://cave.example.org/api/auth/google/callback

# ---- Compte de secours local (argon2) — laisser vide pour ne pas en créer ----
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD=

# ---- Administration ----
# Inscription libre : n'importe quel compte Google obtient un accès immédiat.
# La liste blanche `allowed_email` n'est plus utilisée. ADMIN_EMAILS est la
# seule façon de désigner un administrateur (l'espace /admin permet ensuite d'en
# promouvoir ou d'en retirer d'autres, et de bloquer un compte indésirable).
# Adresses séparées par des virgules, en minuscules.
ADMIN_EMAILS=

# ---- Vision (Gemini) ----
GEMINI_API_KEY=
# Modèle de départ (Flash ou Lite seulement), tant qu'aucun n'est choisi dans Administration › Coûts de l'IA.
GEMINI_MODEL=gemini-3.8-flash
# Plafond mensuel de dépense vision, en centimes (500 = 5 €). Au-delà, l'extraction est refusée.
GEMINI_MONTHLY_CAP_CENTS=500
# Journal des appels Gemini : effacé chaque jour au-delà de ce nombre de jours (92 au moins).
GEMINI_JOURNAL_RETENTION_DAYS=365
# Délai d'un essai Gemini en ms (lecture d'étiquette, accords d'un plat) : au-delà, le modèle est mis de côté 15 min et le suivant est essayé.
GEMINI_ATTEMPT_TIMEOUT_MS=45000

# ---- Sauvegarde vers le NAS (service `sauvegarde`) ----
# Obligatoires : la stack refuse de démarrer sans elles. Jamais dans le dépôt.
# Options de montage NFS, par exemple : addr=<IP du NAS>,nfsvers=4.1,soft,timeo=150,retrans=3
NAS_OPTIONS=
# Export NFS et dossier de sauvegarde, avec le deux-points, par exemple :
# :/volumeN/<partage>/<dossier> (`showmount -e <IP du NAS>` donne l'export)
NAS_CHEMIN=
# Heure de la sauvegarde quotidienne, heure de Paris (3 par défaut).
SAUVEGARDE_HEURE=3
